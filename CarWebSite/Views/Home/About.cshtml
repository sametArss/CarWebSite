@model EntityLayer.Models.About
@{
    ViewData["Title"] = "Hakkımızda";
}
<div class="py-5" style="background: linear-gradient(135deg, #232526 0%, #414345 100%); min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card p-5 shadow-lg border-0 bg-dark" style="color: #f1f3f5;">
                    <div class="text-center mb-5">
                        <span style="display:inline-block; background: linear-gradient(90deg, #0d6efd 0%, #800020 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                            <svg width="70" height="70" fill="none" viewBox="0 0 24 24" stroke="#0d6efd"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0-1.104.896-2 2-2s2 .896 2 2-.896 2-2 2-2-.896-2-2zm0 0V7m0 4v4m0 0c0 1.104-.896 2-2 2s-2-.896-2-2 .896-2 2-2 2 .896 2 2z"/></svg>
                        </span>
                        <h1 class="fw-bold display-5 mt-3 mb-2" style="background: linear-gradient(90deg, #0d6efd 0%, #800020 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: #e9ecef;">Hakkımızda</h1>
                        <p class="lead mb-0" style="color: #e9ecef;">@Model.AboutMessage</p>
                    </div>
                    <div class="row text-center mt-4">
                        <div class="col-md-4 mb-3">
                            <div class="p-4 bg-secondary bg-opacity-10 rounded shadow-sm h-100" style="color: #f1f3f5;">
                                <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#0d6efd" class="mb-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                <h5 class="fw-bold">Güvenilirlik</h5>
                                <p class="mb-0">Tüm araçlarımız titizlikle kontrol edilir ve güvenle sunulur.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-4 bg-secondary bg-opacity-10 rounded shadow-sm h-100" style="color: #f1f3f5;">
                                <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#ff9800" class="mb-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <h5 class="fw-bold">Müşteri Memnuniyeti</h5>
                                <p class="mb-0">Her zaman müşteri odaklı hizmet anlayışıyla çalışıyoruz.</p>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-4 bg-secondary bg-opacity-10 rounded shadow-sm h-100" style="color: #f1f3f5;">
                                <svg width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#43cea2" class="mb-2"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v4a1 1 0 001 1h3m10-5v4a1 1 0 01-1 1h-3m-4 4h6m-6 4h6"/></svg>
                                <h5 class="fw-bold">Geniş Araç Yelpazesi</h5>
                                <p class="mb-0">Her bütçeye ve zevke uygun araç seçenekleri sunuyoruz.</p>
                            </div>
                        </div>
                    </div>
                </div>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <div class="text-end mt-4">
                        <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#updateAboutModal">
                            Güncelle
                        </button>
                    </div>
                    }
               
                <!-- Modal -->
                <div class="modal fade" id="updateAboutModal" tabindex="-1" aria-labelledby="updateAboutModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content bg-dark text-light">
                            <div class="modal-header">
                                <h5 class="modal-title" id="updateAboutModalLabel">Hakkımızda Metnini Güncelle</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                            </div>
                            <div class="modal-body">
                                <textarea id="aboutMessageInput" class="form-control" rows="6">@Model.AboutMessage</textarea>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                <button type="button" class="btn btn-success" id="saveAboutBtn">Kaydet</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('saveAboutBtn').addEventListener('click', function () {
            var newMessage = document.getElementById('aboutMessageInput').value;
            fetch('/Home/UpdateAbout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newMessage) // Sadece string gönderiyoruz!
            })
            .then(response => response.ok ? response.json() : Promise.reject())
            .then(data => {
                if (data.success) {
                    document.querySelector('.lead.mb-0').textContent = newMessage;
                    var modal = bootstrap.Modal.getInstance(document.getElementById('updateAboutModal'));
                    modal.hide();
                }
            });
        });
    </script>
}
