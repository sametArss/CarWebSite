@model List<EntityLayer.Models.Cars>
@{
    ViewData["Title"] = "Araba Listesi";
}
<div class="container py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <h2 class="fw-bold text-center text-md-start mb-0">Araba Listesi</h2>
        <form method="get" asp-action="Index" class="mb-0 d-flex align-items-center gap-2 justify-content-end" style="min-width:320px;">
            <span class="fw-semibold text-secondary" style="white-space:nowrap;">Filtreleme:</span>
            <select id="sortOrder" name="sortOrder" class="form-select shadow-sm" style="border-radius: 0.7rem; box-shadow: 0 2px 12px rgba(0,0,0,0.08); min-width:200px;" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Context.Request.Query["sortOrder"]) ? "selected" : null)">Varsayılan</option>
                <option value="price_asc" selected="@(Context.Request.Query["sortOrder"]=="price_asc" ? "selected" : null)">Fiyat (Artan)</option>
                <option value="price_desc" selected="@(Context.Request.Query["sortOrder"]=="price_desc" ? "selected" : null)">Fiyat (Azalan)</option>
                <option value="year_desc" selected="@(Context.Request.Query["sortOrder"]=="year_desc" ? "selected" : null)">Model Yılı (Yeni → Eski)</option>
                <option value="year_asc" selected="@(Context.Request.Query["sortOrder"]=="year_asc" ? "selected" : null)">Model Yılı (Eski → Yeni)</option>
                <option value="date_desc" selected="@(Context.Request.Query["sortOrder"]=="date_desc" ? "selected" : null)">Eklenme Tarihi (Yeni → Eski)</option>
                <option value="date_asc" selected="@(Context.Request.Query["sortOrder"]=="date_asc" ? "selected" : null)">Eklenme Tarihi (Eski → Yeni)</option>
            </select>
        </form>
    </div>
    <div class="row g-4 justify-content-center" id="car-list">
        @if (Model != null && Model.Any())
        {
            @foreach (var car in Model)
            {
                <div class="col-md-3">
                    <div class="card h-100 shadow-lg border-0 bg-dark text-light">
                        <img src="@(car.CarImages != null && car.CarImages.Any() ? car.CarImages.First().ImagePath : "https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=600&q=80")" class="card-img-top" alt="@car.Brand.BrandName @car.Models.ModelName" style="height:220px;object-fit:cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@car.Brand.BrandName @car.Models.ModelName</h5>
                            <p class="card-text mb-1">Yıl: @car.Year</p>
                            <p class="card-text mb-2">Fiyat: @car.Price TL</p>
                            <a href="@Url.Action("Detail", "Cars", new { id = car.CarId })" class="btn btn-outline-primary w-100">İncele</a>
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a href="@Url.Action("Create", "Expertise", new { carId = car.CarId })" class="btn btn-outline-warning w-100 mt-2">Ekspertiz Ekle / Güncelle</a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center">
                <p class="fs-4">İlanda Aktif Araba Bulunamadı.</p>
            </div>
        }
    </div>
    <div id="loading" class="text-center my-4" style="display:none;">
        <span class="spinner-border text-primary"></span>
        <span class="ms-2">Yükleniyor...</span>
    </div>
    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
    {
        <div class="text-end mt-4">
            <a class="btn btn-success btn-lg px-4" asp-controller="Cars" asp-action="Add">
                + Araba Ekle
            </a>
        </div>
    }

</div>

@section Scripts {
    <script>
        let page = 1;
        let loading = false;
        let noMoreData = false;
        // Seçili sıralama parametresini al
        function getSortOrder() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('sortOrder') || '';
        }
        window.onscroll = function() {
            if (noMoreData || loading) return;
            if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
                loading = true;
                page++;
                document.getElementById('loading').style.display = 'block';
                const sortOrder = getSortOrder();
                fetch(`/Cars/LoadMore?page=${page}&sortOrder=${encodeURIComponent(sortOrder)}`)
                    .then(response => response.text())
                    .then(html => {
                        if (html.trim() === "") {
                            noMoreData = true;
                        } else {
                            document.getElementById('car-list').insertAdjacentHTML('beforeend', html);
                        }
                        loading = false;
                        document.getElementById('loading').style.display = 'none';
                    })
                    .catch(() => {
                        loading = false;
                        document.getElementById('loading').style.display = 'none';
                    });
            }
        };
    </script>
} 